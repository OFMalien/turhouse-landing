{
  "name": "turhouse-multipage",
  "version": "0.1.0",
  "private": true,
  "description": "Багатосторінковий сайт Tur House (Eleventy)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "eleventy",
    "build:preview": "ELEVENTY_ENV=preview eleventy",
    "build:production": "ELEVENTY_ENV=production eleventy",
    "start": "ELEVENTY_ENV=preview eleventy --serve",
    "clean": "rm -rf _site",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:photos": "node scripts/photos.mjs check",
    "make:static": "node scripts/make-static.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs production",
    "check:data": "node scripts/check-data.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:tracking": "node scripts/check-tracking.mjs preview",
    "check:site": "node scripts/check-site.mjs preview",
    "check:images": "node scripts/check-images.mjs preview",
    "check:content": "node scripts/check-content.mjs preview",
    "check:html": "node scripts/check-html.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "html-validate": "^11.16.1",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.33.0",
    "node-html-parser": "^9.0.4"
  }
}
