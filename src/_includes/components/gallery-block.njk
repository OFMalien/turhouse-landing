{#- Галерея. Очікує змінні gallery { heading } і galleryPhotos (список id з photos.json). Підписи (alt) беруться з паспорта фото.
    sizes залежить від кількості кадрів: сітка auto-fit розтягує 1-2 кадри на пів контейнера (565px), 3+ кадрів вужчі;
    коли кадрів 6, 9, 12 (кратно трьом), ставимо рівно 3 колонки, щоб в останньому ряду не лишалося 1-2 кадри. -#}
{%- if galleryGroups %}
{#- Режим «по типам» (номери): вкладки Стандарт, Напівлюкс, Люкс і карусель для обраного типу. Очікує galleryGroups [{ title, photos[] }]. -#}
<section class="section section--alt" id="gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <h2 id="gallery-title">{{ gallery.heading }}</h2>
    <div class="gallery-tabs" role="tablist" aria-label="Типи номерів">
      {%- for group in galleryGroups %}
      <button
        type="button"
        role="tab"
        class="gallery-tab{% if loop.first %} is-active{% endif %}"
        id="tab-group-{{ loop.index0 }}"
        aria-selected="{% if loop.first %}true{% else %}false{% endif %}"
        aria-controls="panel-group-{{ loop.index0 }}"
        data-group-index="{{ loop.index0 }}"
      >
        {{ group.title }}
      </button>
      {%- endfor %}
    </div>

    {%- asyncEach group in galleryGroups %}
    {%- set groupIndex = loop.index0 %}
    <div
      class="gallery-panel{% if loop.first %} is-active{% endif %}"
      id="panel-group-{{ groupIndex }}"
      role="tabpanel"
      aria-labelledby="tab-group-{{ groupIndex }}"
      tabindex="0"
      {% if not loop.first %}hidden{% endif %}
    >
      <h3 class="gallery-group__title visually-hidden">{{ group.title }}</h3>
      <div class="gallery-carousel" data-carousel>
        <div class="gallery-carousel__viewport">
          <ul class="gallery-carousel__track gallery-grid--group" data-carousel-track>
            {%- asyncEach id in group.photos %}
            <li class="gallery-carousel__slide">
              {% photo id, { sizes: "(min-width: 600px) 500px, 100vw", class: "media" } %}
            </li>
            {%- endeach %}
          </ul>
        </div>
        {%- if group.photos | length > 1 %}
        <div class="gallery-carousel__controls">
          <button type="button" class="carousel-btn carousel-btn--prev" aria-label="Попереднє фото: {{ group.title }}" data-carousel-prev>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <div class="carousel-counter" data-carousel-counter aria-live="polite">
            <span class="carousel-current" data-carousel-current>1</span> / {{ group.photos | length }}
          </div>
          <button type="button" class="carousel-btn carousel-btn--next" aria-label="Наступне фото: {{ group.title }}" data-carousel-next>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
        <div class="carousel-dots" data-carousel-dots aria-hidden="true">
          {%- for id in group.photos %}
          <button type="button" class="carousel-dot{% if loop.first %} is-active{% endif %}" data-index="{{ loop.index0 }}" tabindex="-1"></button>
          {%- endfor %}
        </div>
        {%- endif %}
      </div>
    </div>
    {%- endeach %}
  </div>
</section>
{%- else %}
{%- set galleryCount = galleryPhotos | length %}
{%- set galleryThirds = (galleryCount >= 6 and galleryCount % 3 == 0) %}
{%- if galleryCount <= 2 %}{% set gallerySizes = "(min-width: 1260px) 565px, (min-width: 600px) 50vw, 100vw" %}
{%- elif galleryThirds %}{% set gallerySizes = "(min-width: 1260px) 376px, (min-width: 700px) 33vw, 100vw" %}
{%- else %}{% set gallerySizes = "(min-width: 960px) 380px, (min-width: 600px) 50vw, 100vw" %}{% endif %}
<section class="section section--alt" id="gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <h2 id="gallery-title">{{ gallery.heading }}</h2>
    <ul class="gallery-grid{% if galleryThirds %} gallery-grid--thirds{% endif %}">
      {%- asyncEach id in galleryPhotos %}
      <li>{% photo id, { sizes: gallerySizes, class: "media" } %}</li>
      {%- endeach %}
    </ul>
  </div>
</section>
{%- endif %}
