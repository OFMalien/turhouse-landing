{#- Аналітика: спочатку dataLayer і контекст сторінки, потім (тільки в бойовій збірці) GTM.
    Meta Pixel окремо не підключаємо: на живому сайті його вантажить тег контейнера GTM-PRF3SNG (ANALYTICS_AUDIT.md),
    окремий скрипт дав би подвійний PageView. Контекст задається у front matter сторінки: analytics: { page_type, item_category, price_range, content_ids }
    напряму (головна) або ключем analyticsKind (значення рахуються з _data у src/_data/pageContexts.js). -#}
<script>
window.dataLayer = window.dataLayer || [];
window.dataLayer.push({{ (analytics or pageContexts[analyticsKind]) | pageContext | safe }});
</script>
{%- if env.analyticsEnabled %}
{%- for id in site.analytics.gtm %}
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ id }}');</script>
{%- endfor %}
{%- endif %}
