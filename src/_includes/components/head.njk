{%- set pageTitle = title or site.name -%}
{%- set ogImageUrl = env.origin + '/assets/img/static/' + (ogImage or site.ogImage.file) -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{%- if noindex or env.noindex %}
<meta name="robots" content="noindex">
{%- else %}
<meta name="robots" content="index, follow">
{%- endif %}
{%- if not noCanonical %}
<link rel="canonical" href="{{ page.url | absoluteUrl }}">
{%- endif %}
<meta name="theme-color" content="{{ site.themeColor }}">

<meta property="og:type" content="website">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ ogTitle or pageTitle }}">
{%- if description %}
<meta property="og:description" content="{{ description }}">
{%- endif %}
<meta property="og:url" content="{{ page.url | absoluteUrl }}">
<meta property="og:image" content="{{ ogImageUrl }}">
<meta property="og:image:width" content="{{ site.ogImage.width }}">
<meta property="og:image:height" content="{{ site.ogImage.height }}">
<meta property="og:image:alt" content="{{ ogImageAlt or site.ogImage.alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or pageTitle }}">
{%- if description %}
<meta name="twitter:description" content="{{ description }}">
{%- endif %}
<meta name="twitter:image" content="{{ ogImageUrl }}">

<link rel="icon" href="{{ '/favicon-32.png' | url }}" sizes="32x32" type="image/png">
<link rel="icon" href="{{ '/favicon-192.png' | url }}" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
<link rel="manifest" href="{{ '/site.webmanifest' | url }}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Manrope:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Manrope:wght@400;500;600;700;800&display=swap"></noscript>
<link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
<script>document.documentElement.classList.add('js');</script>
{% include "components/json-ld.njk" %}
{% include "components/analytics.njk" %}
