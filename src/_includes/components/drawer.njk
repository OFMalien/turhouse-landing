{% from "components/icons.njk" import close %}
<div class="nav-drawer on-dark" id="nav-drawer" role="dialog" aria-modal="true" aria-label="Меню сайту" data-placement="mobile_drawer" inert>
  <div class="drawer-head">
    <span class="brand">
      <img src="{{ '/assets/img/static/logo.png' | url }}" width="32" height="32" alt="">
      <span>{{ site.name }}</span>
    </span>
    <button type="button" class="drawer-close" aria-label="Закрити меню">{{ close() }}</button>
  </div>
  <nav class="drawer-links" aria-label="Розділи сайту">
    {%- for item in nav %}
    <a href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
    {%- endfor %}
  </nav>
  <div class="drawer-footer">
    {%- if page.url in site.bookingByContactPages %}
    <a class="btn btn-primary" href="{{ site.links.instagramDirect }}" target="_blank" rel="noopener">{{ site.cta.direct }}</a>
    {%- else %}
    <a class="btn btn-primary" href="{{ site.links.booking }}" target="_blank" rel="noopener">Забронювати онлайн</a>
    {%- endif %}
    <a class="btn" href="tel:{{ site.phone.tel }}" aria-label="Зателефонувати: {{ site.phone.display }}"><span class="nowrap">{{ site.phone.display }}</span></a>
  </div>
</div>
