{%- set promoBanners = [
  { data: winterPromo, id: winterPromo.id or 'promo-winter', placement: 'promo_section_winter', hasPrices: false },
  { data: promo, id: 'promo', placement: 'promo_section_weekend', hasPrices: true }
] -%}
{%- asyncEach entry in promoBanners %}
{%- set banner = entry.data %}
{%- if banner and banner.enabled %}
<section class="promo-banner" id="{{ entry.id }}" aria-labelledby="{{ entry.id }}-title" data-placement="{{ entry.placement }}">
  <div class="wrap">
    <div class="promo-banner__box">
      <div class="promo-banner__poster">
        {% photo banner.image, { sizes: "(min-width: 900px) 400px, 100vw", class: "media" } %}
        {%- if banner.sticker %}
        <p class="promo-sticker" aria-hidden="true"><span class="promo-sticker__big">{{ banner.sticker.big }}</span><span class="promo-sticker__small">{{ banner.sticker.small }}</span></p>
        {%- endif %}
      </div>
      <div class="promo-banner__content">
        <p class="promo-badge">{{ banner.badge }}</p>
        <h2 id="{{ entry.id }}-title" class="promo-banner__title">{{ banner.title }}</h2>
        <p class="lede">{{ banner.lead }}</p>

        {%- if banner.terms and banner.terms.length %}
        <ul class="promo-terms">
          {%- for t in banner.terms %}
          <li>{{ t }}</li>
          {%- endfor %}
        </ul>
        {%- endif %}

        {%- if entry.hasPrices and promoItems.length %}
        <table class="promo-prices">
          <caption class="visually-hidden">Ціни за добу зі знижкою</caption>
          <thead>
            <tr><th scope="col">Варіант</th><th scope="col">Ціна за добу</th></tr>
          </thead>
          <tbody>
            {%- for row in promoItems %}
            <tr class="promo-price">
              <th scope="row" class="promo-price__who">{{ row.label }}</th>
              <td class="promo-price__amounts">
                <span class="visually-hidden">Звичайна ціна:</span> <s>{{ row.was | price }}&nbsp;грн</s>
                <span class="visually-hidden">Ціна зі знижкою:</span> <strong>{{ row.now | price }}&nbsp;грн</strong>
              </td>
            </tr>
            {%- endfor %}
          </tbody>
        </table>
        {%- endif %}
        {%- if banner.note %}
        <p class="promo-banner__note">{{ banner.note }}</p>
        {%- endif %}

        <div class="btn-row">
          <a class="btn btn-primary" href="{{ banner.cta.url }}" target="_blank" rel="noopener">{{ banner.cta.label }}</a>
          <a class="btn" href="tel:{{ site.phone.tel }}" aria-label="Зателефонувати: {{ site.phone.display }}">Зателефонувати</a>
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif %}
{%- endeach %}
