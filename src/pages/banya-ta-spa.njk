---
permalink: "/banya-ta-spa/"
eleventyComputed:
  title: "{{ texts['banya-ta-spa'].meta.title | safe }}"
  description: "{{ texts['banya-ta-spa'].meta.description | safe }}"
  breadcrumbTitle: "{{ texts['banya-ta-spa'].meta.breadcrumbTitle | safe }}"
schemaType: banya-ta-spa
analyticsKind: spa
---
{%- set t = texts['banya-ta-spa'] %}
{%- set hero = t.hero %}
{% include "components/page-hero.njk" %}

<section class="section section--tight" id="complex" aria-labelledby="complex-title">
  <div class="wrap">
    <h2 id="complex-title">{{ t.complex.heading }}</h2>
    <ul class="feature-list complex-list">
      {%- for c in spa.complex %}
      <li>{{ c }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section section--alt" id="price" aria-labelledby="price-title">
  <div class="wrap">
    <h2 id="price-title">{{ t.price.heading }}</h2>
    <p class="lede block-note">{{ t.price.text }}</p>
    <div class="cards-grid" data-placement="spa_price">
      <div class="card-object tariff-card" id="price-first">
        <div class="card-object__body">
          <p class="card-object__meta">{{ spa.price.firstLabel | capitalize }}</p>
          <p class="price"><strong>{{ spa.price.first | price }}&nbsp;грн</strong> <span class="price__unit">{{ spa.price.per }}</span></p>
        </div>
      </div>
      <div class="card-object tariff-card" id="price-next">
        <div class="card-object__body">
          <p class="card-object__meta">{{ spa.price.nextLabel | capitalize }}</p>
          <p class="price"><strong>{{ spa.price.next | price }}&nbsp;грн</strong> <span class="price__unit">{{ spa.price.per }}</span></p>
        </div>
      </div>
      {%- for x in spa.extras %}
      <div class="card-object tariff-card" id="price-{{ x.id }}">
        <div class="card-object__body">
          <p class="card-object__meta">{{ x.label }}</p>
          <p class="price"><strong>{{ x.amount | price }}&nbsp;грн</strong> <span class="price__unit">{{ x.unit }}</span></p>
          {%- if x.note %}
          <p class="card-object__note">{{ x.note }}</p>
          {%- endif %}
        </div>
      </div>
      {%- endfor %}
    </div>
    {%- if spa.pricePoster %}
    <figure class="price-poster">
      {% photo spa.pricePoster, { sizes: "(min-width: 700px) 420px, 100vw", class: "media" } %}
    </figure>
    {%- endif %}
  </div>
</section>

<section class="section section--tight" id="themed-days" aria-labelledby="themed-days-title">
  <div class="wrap">
    <div class="bath-interactive" data-bath-interactive>
      <header class="bath-heading">
        <h2 id="themed-days-title">{{ t.themedDays.heading }}</h2>
      </header>
      <div class="bath-scene">
        {% photo "spa/bath-scene", { sizes: "(min-width: 900px) 900px, 100vw", class: "bath-scene__photo" } %}
        <img class="bath-scene__logo" src="{{ env.pathPrefix }}assets/img/static/spa/turhouse-logo-wood.webp" alt="Tur House" width="266" height="266" loading="lazy" decoding="async">
        <img class="bath-steam bath-steam--near" src="{{ env.pathPrefix }}assets/img/static/spa/steam.webp" alt="" aria-hidden="true" width="600" height="200" loading="lazy" decoding="async">
        <img class="bath-steam bath-steam--far" src="{{ env.pathPrefix }}assets/img/static/spa/steam.webp" alt="" aria-hidden="true" width="600" height="200" loading="lazy" decoding="async">
      </div>
      <div class="bath-choices" role="tablist" aria-label="{{ t.themedDays.heading }}">
        {%- set plaqueLabels = ["День банщика", "Понеділок", "Середа", "Баня + чан"] %}
        {%- for d in t.themedDays.items %}
        {%- set isDefault = (d.id == "ponedilok") %}
        <button
          type="button"
          role="tab"
          class="bath-choice{% if isDefault %} is-active{% endif %}"
          id="tab-{{ d.id }}"
          aria-selected="{% if isDefault %}true{% else %}false{% endif %}"
          aria-controls="panel-{{ d.id }}"
        >
          <span>{{ plaqueLabels[loop.index0] }}</span>
          <svg class="bath-choice__check" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M11.4669 3.72684C11.7558 3.97441 11.788 4.40706 11.5405 4.69596L6.54046 10.5293C6.41749 10.6728 6.2386 10.7549 6.05001 10.7549C5.86142 10.7549 5.68253 10.6728 5.55956 10.5293L3.45956 8.07929C3.212 7.79039 3.24422 7.35774 3.53312 7.11018C3.82201 6.86261 4.25466 6.89483 4.50223 7.18373L6.05001 8.98947L10.4978 3.80045C10.7454 3.51155 11.178 3.47933 11.4669 3.72684Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
        </button>
        {%- endfor %}
      </div>
      <div class="bath-panels">
        {%- for d in t.themedDays.items %}
        {%- set p = spa.themedPrices[d.id] %}
        {%- set isDefault = (d.id == "ponedilok") %}
        <div
          role="tabpanel"
          id="panel-{{ d.id }}"
          aria-labelledby="tab-{{ d.id }}"
          class="bath-offer{% if isDefault %} is-active{% endif %}"
          {% if not isDefault %}hidden{% endif %}
        >
          <h3>{{ d.title }}</h3>
          <p>{{ d.text }}</p>
          {%- if d.note %}
          <p class="bath-offer__note">{{ d.note }}</p>
          {%- endif %}
          {%- if p %}
          <p class="bath-price"><strong>{{ p.amount | price }}&nbsp;грн</strong> <span>{{ p.unit }}</span></p>
          {%- endif %}
        </div>
        {%- endfor %}
      </div>
      <p class="block-note">{{ t.themedDays.note }}</p>
    </div>
  </div>
</section>

<section class="section section--tight" id="cards" aria-labelledby="cards-title">
  <div class="wrap">
    <h2 id="cards-title">{{ t.cards.heading }}</h2>
    {%- set cardInfoOnly = true %}
    <div class="cards-grid" data-placement="spa_cards">
      {%- asyncEach item in spa.cards %}
      {% include "components/card-object.njk" %}
      {%- endeach %}
    </div>
    <div class="btn-row">
      <a class="btn" href="{{ '/rybalka-i-hryby/' | url }}">{{ texts['rybalka-i-hryby'].meta.breadcrumbTitle }}</a>
    </div>
  </div>
</section>

{%- set gallery = t.gallery %}
{%- set galleryPhotos = spaGallery %}
{% include "components/gallery-block.njk" %}

{%- set booking = t.booking %}
{%- set bookingNoOnline = true %}
{% include "components/booking-block.njk" %}
