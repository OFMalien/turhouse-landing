---
permalink: "/velykyi-budynok/"
eleventyComputed:
  title: "{{ texts['velykyi-budynok'].meta.title | safe }}"
  description: "{{ texts['velykyi-budynok'].meta.description | safe }}"
  breadcrumbTitle: "{{ texts['velykyi-budynok'].meta.breadcrumbTitle | safe }}"
schemaType: velykyi-budynok
analyticsKind: bigHouse
---
{%- set t = texts['velykyi-budynok'] %}
{%- set hero = t.hero %}
{% include "components/page-hero.njk" %}

<section class="section text-section" id="story" aria-label="Про Великий будинок">
  <div class="wrap">
    {%- for p in t.story.paragraphs %}
    <p class="lede block-note">{{ p }}</p>
    {%- endfor %}
  </div>
</section>

<section class="section section--tight" id="tariffs" aria-labelledby="tariffs-title">
  <div class="wrap">
    <h2 id="tariffs-title">{{ t.tariffs.heading }}</h2>
    <div class="cards-grid" id="big-house" data-placement="barn_tariffs">
      {%- for tariff in barn.tariffs | selectattr("name") %}
      <article class="card-object tariff-card">
        <div class="card-object__body">
          <h3>{{ tariff.name }}: {{ tariff.label }}</h3>
          <div class="card-object__price">
            <p class="price"><strong>{{ tariff.amount | price }}&nbsp;грн</strong> <span class="price__unit">/ доба</span></p>
          </div>
          <a class="btn btn-primary" href="{{ site.links.booking }}" target="_blank" rel="noopener"
             aria-label="Забронювати: {{ tariff.name }}, {{ tariff.label }}"
             data-item-name="{{ tariff.name }}" data-item-category="{{ barn.category }}" data-item-variant="{{ tariff.label }}" data-value="{{ tariff.amount }}">Забронювати</a>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{%- set gallery = t.gallery %}
{%- set galleryPhotos = t.gallery.photos %}
{% include "components/gallery-block.njk" %}

{%- set booking = t.booking %}
{% include "components/booking-block.njk" %}
