---
permalink: "/okolitsi/"
eleventyComputed:
  title: "{{ texts.okolitsi.meta.title | safe }}"
  description: "{{ texts.okolitsi.meta.description | safe }}"
  breadcrumbTitle: "{{ texts.okolitsi.meta.breadcrumbTitle | safe }}"
schemaType: okolitsi
analyticsKind: area
---
{%- set t = texts.okolitsi %}
{%- set hero = t.hero %}
{% include "components/page-hero.njk" %}

<section class="section text-section" id="intro" aria-label="Про околиці">
  <div class="wrap">
    <p class="lede">{{ t.intro.text }}</p>
  </div>
</section>

<section class="section section--tight" id="park" aria-label="Парк природи">
  <div class="wrap">
    <p class="lede block-note">{{ t.park.text }}</p>
  </div>
</section>

<section class="section section--alt" id="family" aria-labelledby="family-title">
  <div class="wrap">
    <h2 id="family-title">{{ t.family.heading }}</h2>
    <p class="lede block-note">{{ t.family.text }}</p>
  </div>
</section>

{%- set gallery = t.gallery %}
{%- set galleryPhotos = t.gallery.photos %}
{% include "components/gallery-block.njk" %}
